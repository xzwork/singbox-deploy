  #!/usr/bin/env bash

# ============================================================
#
# 3proxy 管理面板
#
# 系统:
#   Alpine Linux
#
# 默认配置:
#   HTTP   : 60002
#   SOCKS5 : 60003
#   User   : meridian
#   Pass   : xzw123..
#
# ============================================================

set -u

# ============================================================
# 基础配置
# ============================================================

REPO="https://dl-cdn.alpinelinux.org/alpine/edge/testing"

CONFIG_DIR="/etc/3proxy"
CONFIG_FILE="${CONFIG_DIR}/3proxy.cfg"
STATE_FILE="${CONFIG_DIR}/3p.conf"

# 为了兼容你的精简 Alpine，
# 不依赖 /var/log
LOG_DIR="${CONFIG_DIR}/log"
LOG_FILE="${LOG_DIR}/3proxy.log"

DEFAULT_USER="meridian"
DEFAULT_PASS="xzw123.."

DEFAULT_HTTP_PORT="60002"
DEFAULT_SOCKS_PORT="60003"

# 128M 小内存机器保持保守
DEFAULT_MAX_CONN="50"

# ============================================================
# 颜色
# ============================================================

RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
NC="\033[0m"

info() {
    echo -e "${BLUE}[INFO]${NC} $*"
}

ok() {
    echo -e "${GREEN}[OK]${NC} $*"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

err() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

pause() {
    echo
    read -r -p "按回车继续..." _
}

# ============================================================
# 基础检查
# ============================================================

check_root() {

    if [ "$(id -u)" != "0" ]; then
        err "必须使用 root 用户"
        exit 1
    fi
}

check_alpine() {

    if [ ! -f /etc/alpine-release ]; then
        err "当前面板只支持 Alpine Linux"
        exit 1
    fi
}

is_installed() {
    command -v 3proxy >/dev/null 2>&1
}

# ============================================================
# State
# ============================================================

load_state() {

    PROXY_USER="$DEFAULT_USER"
    PROXY_PASS="$DEFAULT_PASS"

    HTTP_PORT="$DEFAULT_HTTP_PORT"
    SOCKS_PORT="$DEFAULT_SOCKS_PORT"

    MAX_CONN="$DEFAULT_MAX_CONN"

    if [ -f "$STATE_FILE" ]; then

        local value=""

        value="$(
            grep '^PROXY_USER=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"

        [ -n "$value" ] && PROXY_USER="$value"


        value="$(
            grep '^PROXY_PASS=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"

        [ -n "$value" ] && PROXY_PASS="$value"


        value="$(
            grep '^HTTP_PORT=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"

        [ -n "$value" ] && HTTP_PORT="$value"


        value="$(
            grep '^SOCKS_PORT=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"

        [ -n "$value" ] && SOCKS_PORT="$value"


        value="$(
            grep '^MAX_CONN=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"

        [ -n "$value" ] && MAX_CONN="$value"

    fi
}

save_state() {

    mkdir -p "$CONFIG_DIR"

    cat > "$STATE_FILE" <<EOF
PROXY_USER=${PROXY_USER}
PROXY_PASS=${PROXY_PASS}
HTTP_PORT=${HTTP_PORT}
SOCKS_PORT=${SOCKS_PORT}
MAX_CONN=${MAX_CONN}
EOF

    chmod 600 "$STATE_FILE"
}

load_state

# ============================================================
# 配置备份
# ============================================================

backup_config() {

    if [ -f "$CONFIG_FILE" ]; then

        local BACKUP_FILE

        BACKUP_FILE="${CONFIG_FILE}.bak.$(date +%Y%m%d_%H%M%S)"

        cp "$CONFIG_FILE" "$BACKUP_FILE"

        info "配置已备份:"
        echo "$BACKUP_FILE"
    fi
}

# ============================================================
# 生成 3proxy 配置
# ============================================================

generate_config() {

    mkdir -p "$CONFIG_DIR"
    mkdir -p "$LOG_DIR"

    chmod 700 "$LOG_DIR"

    backup_config

    cat > "$CONFIG_FILE" <<EOF
# ============================================================
# 3proxy configuration
#
# HTTP:
#   ${HTTP_PORT}
#
# SOCKS5:
#   ${SOCKS_PORT}
#
# User:
#   ${PROXY_USER}
#
# ============================================================

# DNS cache
nscache 1024

# Timeout
timeouts 1 5 30 60 180 1800 15 60 15 5

# 128M VPS 保守限制
maxconn ${MAX_CONN}

# Logging
log ${LOG_FILE} D
rotate 3

# ============================================================
# User
#
# CL = clear text password
# ============================================================

users ${PROXY_USER}:CL:${PROXY_PASS}

# ============================================================
# HTTP / HTTPS Proxy
# ============================================================

auth strong

allow ${PROXY_USER}

proxy -p${HTTP_PORT} -i0.0.0.0

flush


# ============================================================
# SOCKS5
# ============================================================

auth strong

allow ${PROXY_USER}

socks -p${SOCKS_PORT} -i0.0.0.0

flush
EOF

    chmod 600 "$CONFIG_FILE"

    save_state

    ok "配置已生成"
}

# ============================================================
# 安装
# ============================================================

install_3proxy() {

    echo

    info "开始安装 3proxy..."

    apk update || {
        err "apk update 失败"
        return
    }

    # 基础工具
    apk add \
        --no-cache \
        bash \
        curl \
        iproute2 \
        procps \
        >/dev/null 2>&1 || true

    # 安装 3proxy
    apk add \
        --no-cache \
        --repository="$REPO" \
        3proxy \
        3proxy-openrc

    if ! is_installed; then
        err "3proxy 安装失败"
        return
    fi

    ok "3proxy 已安装"

    echo

    info "3proxy binary:"
    command -v 3proxy

    generate_config

    # 添加开机启动
    rc-update add 3proxy default >/dev/null 2>&1 || true

    echo

    info "启动 3proxy..."

    rc-service 3proxy restart

    sleep 1

    if rc-service 3proxy status >/dev/null 2>&1; then

        ok "3proxy 启动成功"

        echo

        show_ports

        echo

        show_connection

    else

        err "3proxy 启动失败"

        diagnose
    fi
}

# ============================================================
# 更新 3proxy
# ============================================================

update_3proxy() {

    if ! is_installed; then
        warn "3proxy 尚未安装"
        return
    fi

    echo

    info "当前版本:"

    apk info 3proxy 2>/dev/null \
        | head -1 \
        || true

    backup_config

    echo

    info "更新 APK..."

    apk update || {
        err "apk update 失败"
        return
    }

    echo

    info "更新 3proxy..."

    apk add \
        --upgrade \
        --repository="$REPO" \
        3proxy \
        3proxy-openrc

    echo

    info "更新后版本:"

    apk info 3proxy 2>/dev/null \
        | head -1 \
        || true

    echo

    rc-service 3proxy restart

    ok "3proxy 更新完成"
}

# ============================================================
# 更新管理面板
# ============================================================

update_panel() {

    local URL
    local TARGET

    URL="https://raw.githubusercontent.com/xzwork/singbox-deploy/main/3p"
    TARGET="/usr/local/bin/3p"

    echo

    info "正在更新 3p 管理面板..."

    curl -fsSL "$URL" -o "${TARGET}.new" || {
        err "下载失败"
        rm -f "${TARGET}.new"
        return
    }

    if [ ! -s "${TARGET}.new" ]; then
        err "下载文件为空"
        rm -f "${TARGET}.new"
        return
    fi

    sed -i 's/\r$//' "${TARGET}.new"

    chmod +x "${TARGET}.new"

    mv "${TARGET}.new" "$TARGET"

    ok "管理面板更新完成"
}

# ============================================================
# 卸载
# ============================================================

uninstall_3proxy() {

    echo

    warn "即将卸载 3proxy"

    echo

    read -r -p "确认卸载？(y/N): " CONFIRM

    case "$CONFIRM" in

        y|Y)
            ;;

        *)
            info "已取消"
            return
            ;;

    esac

    rc-service 3proxy stop >/dev/null 2>&1 || true

    rc-update del 3proxy default >/dev/null 2>&1 || true

    apk del \
        3proxy \
        3proxy-openrc \
        >/dev/null 2>&1 \
        || true

    echo

    read -r -p "是否删除配置 /etc/3proxy？(y/N): " DEL_CONFIG

    case "$DEL_CONFIG" in

        y|Y)

            rm -rf "$CONFIG_DIR"

            ok "3proxy 和配置已删除"

            ;;

        *)

            ok "3proxy 已卸载，配置保留"

            ;;

    esac
}

# ============================================================
# 修改用户名
# ============================================================

change_user() {

    load_state

    echo
    echo "当前用户名:"
    echo
    echo "$PROXY_USER"
    echo

    read -r -p "请输入新用户名: " NEW_USER

    if [ -z "$NEW_USER" ]; then
        warn "用户名不能为空"
        return
    fi

    if echo "$NEW_USER" | grep -q ':'; then
        err "用户名不能包含冒号 ':'"
        return
    fi

    PROXY_USER="$NEW_USER"

    generate_config

    restart_service
}

# ============================================================
# 修改密码
# ============================================================

change_password() {

    load_state

    echo
    echo "当前密码:"
    echo
    echo "$PROXY_PASS"
    echo

    read -r -p "请输入新密码: " NEW_PASS

    if [ -z "$NEW_PASS" ]; then
        warn "密码不能为空"
        return
    fi

    # CL 格式用 : 分隔
    if echo "$NEW_PASS" | grep -q ':'; then
        err "密码暂不支持包含 ':'"
        return
    fi

    PROXY_PASS="$NEW_PASS"

    generate_config

    restart_service
}

# ============================================================
# 修改 HTTP 端口
# ============================================================

change_http_port() {

    load_state

    echo
    echo "当前 HTTP 端口:"
    echo
    echo "$HTTP_PORT"
    echo

    read -r -p "请输入新 HTTP 端口: " NEW_PORT

    if ! echo "$NEW_PORT" | grep -Eq '^[0-9]+$'; then
        err "端口必须为数字"
        return
    fi

    if [ "$NEW_PORT" -lt 1 ] || [ "$NEW_PORT" -gt 65535 ]; then
        err "端口范围 1-65535"
        return
    fi

    if [ "$NEW_PORT" = "$SOCKS_PORT" ]; then
        err "HTTP 和 SOCKS5 不能使用同一端口"
        return
    fi

    HTTP_PORT="$NEW_PORT"

    generate_config

    restart_service
}

# ============================================================
# 修改 SOCKS5 端口
# ============================================================

change_socks_port() {

    load_state

    echo
    echo "当前 SOCKS5 端口:"
    echo
    echo "$SOCKS_PORT"
    echo

    read -r -p "请输入新 SOCKS5 端口: " NEW_PORT

    if ! echo "$NEW_PORT" | grep -Eq '^[0-9]+$'; then
        err "端口必须为数字"
        return
    fi

    if [ "$NEW_PORT" -lt 1 ] || [ "$NEW_PORT" -gt 65535 ]; then
        err "端口范围 1-65535"
        return
    fi

    if [ "$NEW_PORT" = "$HTTP_PORT" ]; then
        err "HTTP 和 SOCKS5 不能使用同一端口"
        return
    fi

    SOCKS_PORT="$NEW_PORT"

    generate_config

    restart_service
}

# ============================================================
# 修改 maxconn
# ============================================================

change_maxconn() {

    load_state

    echo
    echo "当前最大连接数:"
    echo
    echo "$MAX_CONN"
    echo

    read -r -p "请输入新的最大连接数: " NEW_MAX

    if ! echo "$NEW_MAX" | grep -Eq '^[0-9]+$'; then
        err "必须输入数字"
        return
    fi

    if [ "$NEW_MAX" -lt 1 ]; then
        err "必须大于 0"
        return
    fi

    MAX_CONN="$NEW_MAX"

    generate_config

    restart_service
}

# ============================================================
# 服务控制
# ============================================================

start_service() {

    if ! is_installed; then
        warn "3proxy 尚未安装"
        return
    fi

    rc-service 3proxy start
}

stop_service() {

    if ! is_installed; then
        warn "3proxy 尚未安装"
        return
    fi

    rc-service 3proxy stop
}

restart_service() {

    if ! is_installed; then
        warn "3proxy 尚未安装"
        return
    fi

    echo

    if rc-service 3proxy restart; then

        ok "3proxy 重启成功"

    else

        err "3proxy 重启失败"

        diagnose
    fi
}

# ============================================================
# 状态
# ============================================================

show_status() {

    echo

    if ! is_installed; then
        warn "3proxy 未安装"
        return
    fi

    echo "========== 版本 =========="

    apk info 3proxy 2>/dev/null \
        | head -1 \
        || true

    echo

    echo "========== 服务 =========="

    rc-service 3proxy status || true

    echo

    echo "========== 进程 =========="

    ps | grep '[3]proxy' || true

    echo

    echo "========== 监听 =========="

    show_ports
}

# ============================================================
# 查看端口
# ============================================================

show_ports() {

    load_state

    ss -lntp 2>/dev/null \
        | grep -E ":(${HTTP_PORT}|${SOCKS_PORT})( |$)" \
        || warn "未检测到 60002/60003 对应监听"
}

# ============================================================
# 编辑配置
# ============================================================

edit_config() {

    if [ ! -f "$CONFIG_FILE" ]; then
        warn "配置文件不存在"
        return
    fi

    backup_config

    if command -v nano >/dev/null 2>&1; then

        nano "$CONFIG_FILE"

    else

        vi "$CONFIG_FILE"

    fi

    echo

    read -r -p "是否重启 3proxy？(Y/n): " ANSWER

    case "$ANSWER" in

        n|N)
            ;;

        *)
            restart_service
            ;;

    esac
}

show_config() {

    echo

    if [ ! -f "$CONFIG_FILE" ]; then
        warn "配置文件不存在"
        return
    fi

    cat "$CONFIG_FILE"
}

# ============================================================
# 日志
# ============================================================

show_log() {

    echo

    if [ -f "$LOG_FILE" ]; then

        tail -100 "$LOG_FILE"

    else

        warn "暂无日志"
    fi
}

follow_log() {

    mkdir -p "$LOG_DIR"

    touch "$LOG_FILE"

    echo
    echo "Ctrl+C 退出"
    echo

    tail -f "$LOG_FILE"
}

# ============================================================
# 获取公网 IPv4
# ============================================================

get_public_ip() {

    local IP=""

    for URL in \
        "https://api.ipify.org" \
        "https://ifconfig.me" \
        "https://icanhazip.com"
    do

        IP="$(
            curl \
                -4 \
                -s \
                --connect-timeout 3 \
                --max-time 5 \
                "$URL" \
                2>/dev/null \
                | tr -d '[:space:]' \
                || true
        )"

        if echo "$IP" \
            | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'
        then

            echo "$IP"

            return
        fi

    done

    echo "SERVER_IP"
}

# ============================================================
# 显示代理信息
# ============================================================

show_connection() {

    load_state

    local PUBLIC_IP

    PUBLIC_IP="$(get_public_ip)"

    echo
    echo "=================================================="
    echo "HTTP / HTTPS"
    echo "=================================================="
    echo
    echo "http://${PROXY_USER}:${PROXY_PASS}@${PUBLIC_IP}:${HTTP_PORT}"
    echo
    echo "=================================================="
    echo "SOCKS5"
    echo "=================================================="
    echo
    echo "socks5://${PROXY_USER}:${PROXY_PASS}@${PUBLIC_IP}:${SOCKS_PORT}"
    echo
    echo "=================================================="
}

# ============================================================
# HTTP 测试
# ============================================================

test_http() {

    load_state

    echo

    info "测试 HTTP Proxy..."

    curl \
        -v \
        --connect-timeout 5 \
        --max-time 15 \
        -x "http://${PROXY_USER}:${PROXY_PASS}@127.0.0.1:${HTTP_PORT}" \
        https://api.ipify.org

    echo
}

# ============================================================
# SOCKS5 测试
# ============================================================

test_socks() {

    load_state

    echo

    info "测试 SOCKS5..."

    curl \
        -v \
        --connect-timeout 5 \
        --max-time 15 \
        --socks5-hostname "127.0.0.1:${SOCKS_PORT}" \
        --proxy-user "${PROXY_USER}:${PROXY_PASS}" \
        https://api.ipify.org

    echo
}

# ============================================================
# 诊断
# ============================================================

diagnose() {

    load_state

    echo
    echo "=================================================="
    echo "                 3proxy 诊断"
    echo "=================================================="

    echo
    echo "[1] Alpine"

    cat /etc/alpine-release 2>/dev/null || true

    echo
    echo "[2] 3proxy"

    apk info 3proxy 2>/dev/null \
        | head -10 \
        || true

    echo
    echo "[3] Binary"

    command -v 3proxy || true

    ls -l /usr/bin/3proxy 2>/dev/null || true

    echo
    echo "[4] OpenRC"

    ls -l /etc/init.d/3proxy 2>/dev/null || true

    rc-service 3proxy status 2>&1 || true

    echo
    echo "[5] Process"

    ps | grep '[3]proxy' || true

    echo
    echo "[6] Port"

    ss -lntp 2>/dev/null \
        | grep -E ":(${HTTP_PORT}|${SOCKS_PORT})( |$)" \
        || true

    echo
    echo "[7] Config"

    cat "$CONFIG_FILE" 2>/dev/null || true

    echo
    echo "[8] Log"

    tail -100 "$LOG_FILE" 2>/dev/null || true

    echo
    echo "=================================================="
}

# ============================================================
# 菜单
# ============================================================

show_menu() {

    # 某些极简 VPS TERM 不完整，因此不强制 clear
    if [ -n "${TERM:-}" ]; then
        clear 2>/dev/null || true
    fi

    load_state

    echo "=================================================="
    echo "              3proxy 管理面板"
    echo "=================================================="

    if is_installed; then

        local VERSION

        VERSION="$(
            apk info 3proxy 2>/dev/null \
                | head -1 \
                || echo unknown
        )"

        echo "状态   : 已安装"
        echo "版本   : $VERSION"

    else

        echo "状态   : 未安装"

    fi

    echo
    echo "HTTP   : ${HTTP_PORT}"
    echo "SOCKS5 : ${SOCKS_PORT}"
    echo "用户   : ${PROXY_USER}"
    echo "并发   : ${MAX_CONN}"

    echo
    echo "--------------- 安装管理 ---------------"
    echo "1)  安装 3proxy"
    echo "2)  更新 3proxy"
    echo "3)  卸载 3proxy"
    echo "4)  更新 3p 面板"

    echo
    echo "--------------- 配置管理 ---------------"
    echo "5)  修改用户名"
    echo "6)  修改密码"
    echo "7)  修改 HTTP 端口"
    echo "8)  修改 SOCKS5 端口"
    echo "9)  修改最大连接数"
    echo "10) 编辑完整配置"
    echo "11) 查看完整配置"

    echo
    echo "--------------- 服务管理 ---------------"
    echo "12) 启动"
    echo "13) 停止"
    echo "14) 重启"
    echo "15) 查看状态"

    echo
    echo "--------------- 测试信息 ---------------"
    echo "16) 查看代理地址"
    echo "17) 测试 HTTP"
    echo "18) 测试 SOCKS5"
    echo "19) 查看日志"
    echo "20) 实时日志"
    echo "21) 故障诊断"

    echo
    echo "0)  退出"
    echo
    echo "=================================================="
}

# ============================================================
# MAIN
# ============================================================

check_root
check_alpine

while true
do

    show_menu

    read -r -p "请选择: " CHOICE

    case "${CHOICE:-}" in

        1)

            install_3proxy
            pause

            ;;

        2)

            update_3proxy
            pause

            ;;

        3)

            uninstall_3proxy
            pause

            ;;

        4)

            update_panel
            pause

            ;;

        5)

            change_user
            pause

            ;;

        6)

            change_password
            pause

            ;;

        7)

            change_http_port
            pause

            ;;

        8)

            change_socks_port
            pause

            ;;

        9)

            change_maxconn
            pause

            ;;

        10)

            edit_config
            pause

            ;;

        11)

            show_config
            pause

            ;;

        12)

            start_service
            pause

            ;;

        13)

            stop_service
            pause

            ;;

        14)

            restart_service
            pause

            ;;

        15)

            show_status
            pause

            ;;

        16)

            show_connection
            pause

            ;;

        17)

            test_http
            pause

            ;;

        18)

            test_socks
            pause

            ;;

        19)

            show_log
            pause

            ;;

        20)

            follow_log

            ;;

        21)

            diagnose
            pause

            ;;

        0)

            exit 0

            ;;

        *)

            warn "无效选项"

            sleep 1

            ;;

    esac

done
