#!/usr/bin/env bash

set -u

# ============================================================
# 3proxy 管理面板
# Alpine Linux
# ============================================================

REPO="https://dl-cdn.alpinelinux.org/alpine/edge/testing"

CONFIG_DIR="/etc/3proxy"
CONFIG_FILE="${CONFIG_DIR}/3proxy.cfg"
STATE_FILE="${CONFIG_DIR}/3p.conf"

LOG_DIR="${CONFIG_DIR}/log"
LOG_FILE="${LOG_DIR}/3proxy.log"

DEFAULT_MAX_CONN="500"

PANEL_URL="https://raw.githubusercontent.com/xzwork/singbox-deploy/main/3p"

# ============================================================
# 颜色
# ============================================================

RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
NC="\033[0m"

info() {
    echo -e "${BLUE}[INFO]${NC} $*"
}

ok() {
    echo -e "${GREEN}[OK]${NC} $*"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

err() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

pause() {
    echo
    read -r -p "按回车继续..." _
}

# ============================================================
# 基础检查
# ============================================================

check_root() {
    if [ "$(id -u)" != "0" ]; then
        err "必须使用 root 用户运行"
        exit 1
    fi
}

check_alpine() {
    if [ ! -f /etc/alpine-release ]; then
        err "此脚本仅支持 Alpine Linux"
        exit 1
    fi
}

is_installed() {
    command -v 3proxy >/dev/null 2>&1
}

# ============================================================
# 状态文件
# ============================================================

load_state() {

    PROXY_USER=""
    PROXY_PASS=""
    HTTP_PORT=""
    SOCKS_PORT=""
    MAX_CONN="$DEFAULT_MAX_CONN"

    if [ -f "$STATE_FILE" ]; then

        local value=""

        value="$(
            grep '^PROXY_USER=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"
        [ -n "$value" ] && PROXY_USER="$value"

        value="$(
            grep '^PROXY_PASS=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"
        [ -n "$value" ] && PROXY_PASS="$value"

        value="$(
            grep '^HTTP_PORT=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"
        [ -n "$value" ] && HTTP_PORT="$value"

        value="$(
            grep '^SOCKS_PORT=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"
        [ -n "$value" ] && SOCKS_PORT="$value"

        value="$(
            grep '^MAX_CONN=' "$STATE_FILE" 2>/dev/null \
            | head -1 \
            | cut -d= -f2- \
            || true
        )"
        [ -n "$value" ] && MAX_CONN="$value"
    fi
}

save_state() {

    mkdir -p "$CONFIG_DIR"

    cat > "$STATE_FILE" <<EOF
PROXY_USER=${PROXY_USER}
PROXY_PASS=${PROXY_PASS}
HTTP_PORT=${HTTP_PORT}
SOCKS_PORT=${SOCKS_PORT}
MAX_CONN=${MAX_CONN}
EOF

    chmod 600 "$STATE_FILE"
}

# ============================================================
# 输入校验
# ============================================================

validate_port() {

    local PORT="$1"

    if ! echo "$PORT" | grep -Eq '^[0-9]+$'; then
        return 1
    fi

    if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
        return 1
    fi

    return 0
}

input_initial_config() {

    echo
    echo "=============================================="
    echo "              首次安装配置"
    echo "=============================================="
    echo

    while true
    do
        read -r -p "请输入代理用户名: " PROXY_USER

        if [ -z "$PROXY_USER" ]; then
            warn "用户名不能为空"
            continue
        fi

        if echo "$PROXY_USER" | grep -q ':'; then
            warn "用户名不能包含 ':'"
            continue
        fi

        break
    done

    echo

    while true
    do
        read -r -s -p "请输入代理密码: " PROXY_PASS
        echo

        if [ -z "$PROXY_PASS" ]; then
            warn "密码不能为空"
            continue
        fi

        if echo "$PROXY_PASS" | grep -q ':'; then
            warn "密码暂不支持包含 ':'"
            continue
        fi

        break
    done

    echo

    while true
    do
        read -r -p "请输入 HTTP/HTTPS 代理端口: " HTTP_PORT

        if ! validate_port "$HTTP_PORT"; then
            warn "端口必须为 1-65535"
            continue
        fi

        break
    done

    echo

    while true
    do
        read -r -p "请输入 SOCKS5 代理端口: " SOCKS_PORT

        if ! validate_port "$SOCKS_PORT"; then
            warn "端口必须为 1-65535"
            continue
        fi

        if [ "$SOCKS_PORT" = "$HTTP_PORT" ]; then
            warn "SOCKS5 端口不能和 HTTP 端口相同"
            continue
        fi

        break
    done

    MAX_CONN="$DEFAULT_MAX_CONN"

    echo
    echo "----------------------------------------------"
    echo "用户名       : $PROXY_USER"
    echo "HTTP 端口    : $HTTP_PORT"
    echo "SOCKS5 端口  : $SOCKS_PORT"
    echo "最大连接数   : $MAX_CONN"
    echo "----------------------------------------------"
}

# ============================================================
# 服务用户与权限
# ============================================================

get_service_user() {

    SERVICE_USER=""
    SERVICE_GROUP=""

    if id 3proxy >/dev/null 2>&1; then
        SERVICE_USER="3proxy"
    elif id proxy >/dev/null 2>&1; then
        SERVICE_USER="proxy"
    fi

    if [ -n "$SERVICE_USER" ]; then
        SERVICE_GROUP="$(id -gn "$SERVICE_USER")"
    fi
}

fix_permissions() {

    get_service_user

    mkdir -p "$CONFIG_DIR"
    mkdir -p "$LOG_DIR"

    if [ -n "$SERVICE_USER" ]; then

        chown "$SERVICE_USER:$SERVICE_GROUP" "$CONFIG_FILE" 2>/dev/null || true
        chmod 600 "$CONFIG_FILE" 2>/dev/null || true

        chown -R "$SERVICE_USER:$SERVICE_GROUP" "$LOG_DIR" 2>/dev/null || true
        chmod 700 "$LOG_DIR" 2>/dev/null || true

    else

        chmod 600 "$CONFIG_FILE" 2>/dev/null || true
        chmod 755 "$LOG_DIR" 2>/dev/null || true
    fi
}

# ============================================================
# 配置备份
# ============================================================

backup_config() {

    if [ -f "$CONFIG_FILE" ]; then

        local BACKUP_FILE

        BACKUP_FILE="${CONFIG_FILE}.bak.$(date +%Y%m%d_%H%M%S)"

        cp "$CONFIG_FILE" "$BACKUP_FILE"

        info "配置已备份:"
        echo "$BACKUP_FILE"
    fi
}

# ============================================================
# 生成配置
# ============================================================

generate_config() {

    mkdir -p "$CONFIG_DIR"
    mkdir -p "$LOG_DIR"

    backup_config

    cat > "$CONFIG_FILE" <<EOF
# ============================================================
# 3proxy configuration
# ============================================================

nscache 1024

timeouts 1 5 30 60 180 1800 15 60 15 5

maxconn ${MAX_CONN}

log ${LOG_FILE} D
rotate 3

users ${PROXY_USER}:CL:${PROXY_PASS}

# ============================================================
# HTTP / HTTPS
# ============================================================

auth strong
allow ${PROXY_USER}

proxy -p${HTTP_PORT} -i0.0.0.0

flush

# ============================================================
# SOCKS5
# ============================================================

auth strong
allow ${PROXY_USER}

socks -p${SOCKS_PORT} -i0.0.0.0

flush
EOF

    save_state

    fix_permissions

    ok "配置已生成"
}

# ============================================================
# 安装
# ============================================================

install_3proxy() {

    if is_installed; then
        warn "3proxy 已经安装"
        return
    fi

    input_initial_config

    echo
    info "更新 APK..."

    apk update || {
        err "apk update 失败"
        return
    }

    info "安装基础工具..."

    apk add \
        --no-cache \
        bash \
        curl \
        iproute2 \
        procps \
        >/dev/null 2>&1 || true

    info "安装 3proxy..."

    apk add \
        --no-cache \
        --repository="$REPO" \
        3proxy \
        3proxy-openrc || {
            err "3proxy 安装失败"
            return
        }

    if ! is_installed; then
        err "安装完成但未找到 3proxy"
        return
    fi

    generate_config

    rc-update add 3proxy default >/dev/null 2>&1 || true

    echo
    info "启动服务..."

    if rc-service 3proxy restart; then
        sleep 1
    else
        err "服务启动失败"
        diagnose
        return
    fi

    if rc-service 3proxy status >/dev/null 2>&1; then

        ok "3proxy 安装并启动成功"

        echo
        show_connection

    else

        err "3proxy 启动后状态异常"
        diagnose
    fi
}

# ============================================================
# 更新 3proxy
# ============================================================

update_3proxy() {

    if ! is_installed; then
        warn "3proxy 尚未安装"
        return
    fi

    backup_config

    info "更新 APK..."

    apk update || {
        err "apk update 失败"
        return
    }

    info "更新 3proxy..."

    apk add \
        --upgrade \
        --repository="$REPO" \
        3proxy \
        3proxy-openrc || {
            err "更新失败"
            return
        }

    fix_permissions

    rc-service 3proxy restart || {
        err "更新完成，但服务重启失败"
        diagnose
        return
    }

    ok "3proxy 更新完成"
}

# ============================================================
# 更新面板
# ============================================================

update_panel() {

    local TARGET="/usr/local/bin/3p"

    info "更新 3p 面板..."

    curl -fsSL "$PANEL_URL" -o "${TARGET}.new" || {
        err "下载失败"
        rm -f "${TARGET}.new"
        return
    }

    if [ ! -s "${TARGET}.new" ]; then
        err "下载文件为空"
        rm -f "${TARGET}.new"
        return
    fi

    sed -i 's/\r$//' "${TARGET}.new"

    chmod +x "${TARGET}.new"

    mv "${TARGET}.new" "$TARGET"

    ok "管理面板更新完成"
}

# ============================================================
# 卸载
# ============================================================

uninstall_3proxy() {

    echo

    warn "即将卸载 3proxy"

    read -r -p "确认卸载？(y/N): " CONFIRM

    case "$CONFIRM" in
        y|Y)
            ;;
        *)
            info "已取消"
            return
            ;;
    esac

    rc-service 3proxy stop >/dev/null 2>&1 || true
    rc-update del 3proxy default >/dev/null 2>&1 || true

    apk del 3proxy 3proxy-openrc >/dev/null 2>&1 || true

    echo

    read -r -p "是否同时删除 /etc/3proxy 配置？(y/N): " DEL_CONFIG

    case "$DEL_CONFIG" in

        y|Y)
            rm -rf "$CONFIG_DIR"
            ok "程序和配置已删除"
            ;;

        *)
            ok "程序已卸载，配置已保留"
            ;;
    esac
}

# ============================================================
# 修改用户名
# ============================================================

change_user() {

    load_state

    if [ -z "$PROXY_USER" ]; then
        warn "尚未完成初始配置"
        return
    fi

    echo
    echo "当前用户名：$PROXY_USER"
    echo

    read -r -p "请输入新用户名: " NEW_USER

    if [ -z "$NEW_USER" ]; then
        warn "用户名不能为空"
        return
    fi

    if echo "$NEW_USER" | grep -q ':'; then
        err "用户名不能包含 ':'"
        return
    fi

    PROXY_USER="$NEW_USER"

    generate_config

    restart_service
}

# ============================================================
# 修改密码
# ============================================================

change_password() {

    load_state

    if [ -z "$PROXY_PASS" ]; then
        warn "尚未完成初始配置"
        return
    fi

    echo

    read -r -s -p "请输入新密码: " NEW_PASS
    echo

    if [ -z "$NEW_PASS" ]; then
        warn "密码不能为空"
        return
    fi

    if echo "$NEW_PASS" | grep -q ':'; then
        err "密码暂不支持包含 ':'"
        return
    fi

    PROXY_PASS="$NEW_PASS"

    generate_config

    restart_service
}

# ============================================================
# 修改 HTTP 端口
# ============================================================

change_http_port() {

    load_state

    echo
    echo "当前 HTTP 端口：$HTTP_PORT"
    echo

    read -r -p "请输入新 HTTP 端口: " NEW_PORT

    if ! validate_port "$NEW_PORT"; then
        err "端口必须为 1-65535"
        return
    fi

    if [ "$NEW_PORT" = "$SOCKS_PORT" ]; then
        err "HTTP 和 SOCKS5 不能使用相同端口"
        return
    fi

    HTTP_PORT="$NEW_PORT"

    generate_config

    restart_service
}

# ============================================================
# 修改 SOCKS5 端口
# ============================================================

change_socks_port() {

    load_state

    echo
    echo "当前 SOCKS5 端口：$SOCKS_PORT"
    echo

    read -r -p "请输入新 SOCKS5 端口: " NEW_PORT

    if ! validate_port "$NEW_PORT"; then
        err "端口必须为 1-65535"
        return
    fi

    if [ "$NEW_PORT" = "$HTTP_PORT" ]; then
        err "HTTP 和 SOCKS5 不能使用相同端口"
        return
    fi

    SOCKS_PORT="$NEW_PORT"

    generate_config

    restart_service
}

# ============================================================
# 修改最大连接数
# ============================================================

change_maxconn() {

    load_state

    echo
    echo "当前最大连接数：$MAX_CONN"
    echo

    read -r -p "请输入新的最大连接数: " NEW_MAX

    if ! echo "$NEW_MAX" | grep -Eq '^[0-9]+$'; then
        err "必须输入数字"
        return
    fi

    if [ "$NEW_MAX" -lt 1 ]; then
        err "必须大于 0"
        return
    fi

    MAX_CONN="$NEW_MAX"

    generate_config

    restart_service
}

# ============================================================
# 服务控制
# ============================================================

start_service() {

    if ! is_installed; then
        warn "3proxy 尚未安装"
        return
    fi

    rc-service 3proxy start
}

stop_service() {

    if ! is_installed; then
        warn "3proxy 尚未安装"
        return
    fi

    rc-service 3proxy stop
}

restart_service() {

    if ! is_installed; then
        warn "3proxy 尚未安装"
        return
    fi

    fix_permissions

    if rc-service 3proxy restart; then
        ok "3proxy 重启成功"
    else
        err "3proxy 重启失败"
        diagnose
    fi
}

# ============================================================
# 状态
# ============================================================

show_status() {

    echo

    if ! is_installed; then
        warn "3proxy 未安装"
        return
    fi

    echo "========== 版本 =========="

    apk info 3proxy 2>/dev/null \
        | head -1 \
        || true

    echo

    echo "========== 服务 =========="

    rc-service 3proxy status || true

    echo

    echo "========== 进程 =========="

    ps | grep '[3]proxy' || true

    echo

    echo "========== 监听 =========="

    show_ports
}

# ============================================================
# 查看端口
# ============================================================

show_ports() {

    load_state

    if [ -z "$HTTP_PORT" ] || [ -z "$SOCKS_PORT" ]; then
        warn "尚未完成初始配置"
        return
    fi

    ss -lntp 2>/dev/null \
        | grep -E ":(${HTTP_PORT}|${SOCKS_PORT})( |$)" \
        || warn "未检测到代理端口监听"
}

# ============================================================
# 编辑配置
# ============================================================

edit_config() {

    if [ ! -f "$CONFIG_FILE" ]; then
        warn "配置文件不存在"
        return
    fi

    backup_config

    if command -v nano >/dev/null 2>&1; then
        nano "$CONFIG_FILE"
    else
        vi "$CONFIG_FILE"
    fi

    fix_permissions

    echo

    read -r -p "是否重启 3proxy 应用配置？(Y/n): " ANSWER

    case "$ANSWER" in
        n|N)
            ;;
        *)
            restart_service
            ;;
    esac
}

show_config() {

    echo

    if [ ! -f "$CONFIG_FILE" ]; then
        warn "配置文件不存在"
        return
    fi

    cat "$CONFIG_FILE"
}

# ============================================================
# 日志
# ============================================================

show_log() {

    echo

    if [ -f "$LOG_FILE" ]; then
        tail -100 "$LOG_FILE"
    else
        warn "暂无日志"
    fi
}

follow_log() {

    mkdir -p "$LOG_DIR"
    touch "$LOG_FILE"

    fix_permissions

    echo
    echo "Ctrl+C 退出"
    echo

    tail -f "$LOG_FILE"
}

# ============================================================
# 获取公网 IP
# ============================================================

get_public_ip() {

    local IP=""

    for URL in \
        "https://api.ipify.org" \
        "https://ifconfig.me" \
        "https://icanhazip.com"
    do

        IP="$(
            curl \
                -4 \
                -s \
                --connect-timeout 3 \
                --max-time 5 \
                "$URL" \
                2>/dev/null \
                | tr -d '[:space:]' \
                || true
        )"

        if echo "$IP" \
            | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'
        then
            echo "$IP"
            return
        fi
    done

    echo "SERVER_IP"
}

# ============================================================
# 查看代理地址
# ============================================================

show_connection() {

    load_state

    if [ -z "$PROXY_USER" ] \
        || [ -z "$PROXY_PASS" ] \
        || [ -z "$HTTP_PORT" ] \
        || [ -z "$SOCKS_PORT" ]
    then
        warn "尚未完成初始配置"
        return
    fi

    local PUBLIC_IP
    PUBLIC_IP="$(get_public_ip)"

    echo
    echo "=================================================="
    echo "HTTP / HTTPS"
    echo "=================================================="
    echo
    echo "http://${PROXY_USER}:${PROXY_PASS}@${PUBLIC_IP}:${HTTP_PORT}"

    echo
    echo "=================================================="
    echo "SOCKS5"
    echo "=================================================="
    echo
    echo "socks5://${PROXY_USER}:${PROXY_PASS}@${PUBLIC_IP}:${SOCKS_PORT}"

    echo
    echo "=================================================="
}

# ============================================================
# HTTP 测试
# ============================================================

test_http() {

    load_state

    if [ -z "$HTTP_PORT" ]; then
        warn "尚未完成初始配置"
        return
    fi

    echo
    info "测试 HTTP Proxy..."

    curl \
        -v \
        --connect-timeout 5 \
        --max-time 15 \
        -x "http://${PROXY_USER}:${PROXY_PASS}@127.0.0.1:${HTTP_PORT}" \
        https://api.ipify.org

    echo
}

# ============================================================
# SOCKS5 测试
# ============================================================

test_socks() {

    load_state

    if [ -z "$SOCKS_PORT" ]; then
        warn "尚未完成初始配置"
        return
    fi

    echo
    info "测试 SOCKS5..."

    curl \
        -v \
        --connect-timeout 5 \
        --max-time 15 \
        --socks5-hostname "127.0.0.1:${SOCKS_PORT}" \
        --proxy-user "${PROXY_USER}:${PROXY_PASS}" \
        https://api.ipify.org

    echo
}

# ============================================================
# 诊断
# ============================================================

diagnose() {

    load_state

    echo
    echo "=================================================="
    echo "                 3proxy 诊断"
    echo "=================================================="

    echo
    echo "[1] Alpine"
    cat /etc/alpine-release 2>/dev/null || true

    echo
    echo "[2] Package"
    apk info 3proxy 2>/dev/null | head -10 || true

    echo
    echo "[3] Binary"
    command -v 3proxy || true
    ls -l /usr/bin/3proxy 2>/dev/null || true

    echo
    echo "[4] Service User"
    get_service_user
    echo "${SERVICE_USER:-unknown}:${SERVICE_GROUP:-unknown}"

    echo
    echo "[5] OpenRC"
    ls -l /etc/init.d/3proxy 2>/dev/null || true
    rc-service 3proxy status 2>&1 || true

    echo
    echo "[6] Process"
    ps | grep '[3]proxy' || true

    echo
    echo "[7] Ports"

    if [ -n "$HTTP_PORT" ] && [ -n "$SOCKS_PORT" ]; then
        ss -lntp 2>/dev/null \
            | grep -E ":(${HTTP_PORT}|${SOCKS_PORT})( |$)" \
            || true
    fi

    echo
    echo "[8] Config Permission"
    ls -l "$CONFIG_FILE" 2>/dev/null || true

    echo
    echo "[9] Log Permission"
    ls -ld "$LOG_DIR" 2>/dev/null || true

    echo
    echo "[10] Config"
    cat "$CONFIG_FILE" 2>/dev/null || true

    echo
    echo "[11] Log"
    tail -100 "$LOG_FILE" 2>/dev/null || true

    echo
    echo "=================================================="
}

# ============================================================
# 菜单
# ============================================================

show_menu() {

    if [ -n "${TERM:-}" ]; then
        clear 2>/dev/null || true
    fi

    load_state

    echo "=================================================="
    echo "              3proxy 管理面板"
    echo "=================================================="

    if is_installed; then

        local VERSION

        VERSION="$(
            apk info 3proxy 2>/dev/null \
                | head -1 \
                || echo unknown
        )"

        echo "状态   : 已安装"
        echo "版本   : $VERSION"

    else
        echo "状态   : 未安装"
    fi

    echo

    if [ -n "$PROXY_USER" ]; then
        echo "用户   : $PROXY_USER"
    else
        echo "用户   : 未配置"
    fi

    if [ -n "$HTTP_PORT" ]; then
        echo "HTTP   : $HTTP_PORT"
    else
        echo "HTTP   : 未配置"
    fi

    if [ -n "$SOCKS_PORT" ]; then
        echo "SOCKS5 : $SOCKS_PORT"
    else
        echo "SOCKS5 : 未配置"
    fi

    echo "并发   : $MAX_CONN"

    echo
    echo "--------------- 安装管理 ---------------"
    echo "1)  安装 3proxy"
    echo "2)  更新 3proxy"
    echo "3)  卸载 3proxy"
    echo "4)  更新 3p 面板"

    echo
    echo "--------------- 配置管理 ---------------"
    echo "5)  修改用户名"
    echo "6)  修改密码"
    echo "7)  修改 HTTP 端口"
    echo "8)  修改 SOCKS5 端口"
    echo "9)  修改最大连接数"
    echo "10) 编辑完整配置"
    echo "11) 查看完整配置"

    echo
    echo "--------------- 服务管理 ---------------"
    echo "12) 启动"
    echo "13) 停止"
    echo "14) 重启"
    echo "15) 查看状态"

    echo
    echo "--------------- 测试信息 ---------------"
    echo "16) 查看代理地址"
    echo "17) 测试 HTTP"
    echo "18) 测试 SOCKS5"
    echo "19) 查看日志"
    echo "20) 实时日志"
    echo "21) 故障诊断"

    echo
    echo "0)  退出"

    echo
    echo "=================================================="
}

# ============================================================
# MAIN
# ============================================================

check_root
check_alpine

while true
do

    show_menu

    read -r -p "请选择: " CHOICE

